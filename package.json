{
	"name": "typedly",
	"version": "0.0.28-beta.0",
	"description": "A collection of utility types.",
	"author": "Utily Contributors",
	"license": "MIT",
	"private": false,
	"repository": "https://github.com/utily/typedly",
	"bugs": {
		"url": "https://github.com/utily/typedly/issues"
	},
	"homepage": "https://github.com/utily",
	"type": "module",
	"module": "./dist/mjs/index.js",
	"types": "./dist/types/index.d.ts",
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"exports": {
		".": {
			"import": {
				"default": "./dist/mjs/index.js",
				"types": "./dist/types/index.d.ts"
			},
			"require": {
				"default": "./dist/cjs/index.js",
				"types": "./dist/types/index.d.ts"
			}
		},
		"./dist/types/global": {
			"import": {
				"default": "./dist/mjs/global.js",
				"types": "./dist/types/global.d.ts"
			},
			"require": {
				"default": "./dist/cjs/index.js",
				"types": "./dist/types/global.d.ts"
			}
		}
	},
	"git": {
		"tagName": "v${version}"
	},
	"github": {
		"release": true
	},
	"scripts": {
		"build": "rimraf dist/* && tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json",
		"lint": "biome format .",
		"format": "biome format --write .",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"prepare": "npm run build",
		"clean": "rimraf dist node_modules coverage",
		"verify": "npm run build && npm run test && npm run coverage && npm run lint && npm audit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@types/node": "26.6.11",
		"@vitest/coverage-v8": "5.1.2",
		"rimraf": "6.1.4",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.2"
	},
	"dependencies": {
		"isly": "^0.1.23"
	}
}
